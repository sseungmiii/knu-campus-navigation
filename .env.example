# Local/server environment only. Never commit .env or copy this value to src/.
KAKAO_REST_API_KEY=
DAEGU_BUS_API_KEY=
KMA_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SDK derives JWKS from SUPABASE_URL; optional metadata only.
SUPABASE_JWKS_URL=
# Secret/service-role key is intentionally not used or required.

# Staging project only. Never point it at the production Supabase project.
KNU_ENV=staging
KNU_TEST_SUPABASE_PROJECT_REF=
KNU_ALLOWED_ORIGINS=
